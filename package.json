{
  "name": "mmorpg-monorepo",
  "private": true,
  "scripts": {
    "build:shared": "npm --workspace @mmorpg/shared run build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "workspaces": [
    "shared",
    "backend",
    "realtime",
    "frontend"
  ],
  "dependencies": {
    "typescript": "^6.0.2"
  }
}
